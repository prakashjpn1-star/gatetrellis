{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/prakashjpn1-star/gatetrellis/schemas/fixture-scenario.schema.json",
  "title": "Bounded test-mode fixture scenario",
  "type": "object",
  "properties": {
    "fixtureId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "mode": {
      "enum": [
        "HEALTHY",
        "DELAY",
        "ERROR",
        "DISCONNECT_AFTER_EFFECT"
      ]
    },
    "delayMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5000
    },
    "durationSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60
    }
  },
  "required": [
    "fixtureId",
    "mode",
    "durationSeconds"
  ],
  "additionalProperties": false
}
